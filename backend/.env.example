# Copy to .env. The backend reads this file at startup; nothing is committed.
ANTHROPIC_API_KEY=
# Model that assesses each finding (likelihood, impact, flags). Sonnet keeps a 21-finding process cheap.
TRIAGE_ASSESS_MODEL=claude-sonnet-5-5
# Model that extracts the rules file from the domain document. One call per workspace, quality matters.
TRIAGE_EXTRACT_MODEL=claude-opus-5-5
# Findings assessed in parallel during a process.
TRIAGE_WORKERS=4
# Set to 1 to use a deterministic fake model (no API calls). For development, demos and tests.
TRIAGE_FAKE_MODEL=0
# Seconds the fake model sleeps per call, so the live pipeline view has something to show. 0 in tests.
TRIAGE_FAKE_DELAY=1.2
# The one passphrase the UI asks for. A demo gate in front of the API, not an identity system.
TRIAGE_PASSPHRASE=XYZ123321!
# SQLite file. Relative paths resolve against the backend directory.
TRIAGE_DB=triage.db
